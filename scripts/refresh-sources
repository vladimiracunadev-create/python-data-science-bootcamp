PAPER_HOSTS = (
    "arxiv.org", "doi.org", "dl.acm.org", "papers.nips.cc", "proceedings.neurips.cc",
    "proceedings.mlr.press", "jmlr.org", "aclanthology.org", "joss.theoj.org",
